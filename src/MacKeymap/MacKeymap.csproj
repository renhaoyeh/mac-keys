<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MacKeymap</RootNamespace>
    <Version>0.1.0</Version>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'=='' and '$(Platform)'=='ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en;zh-Hant</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MacKeymap.Core\MacKeymap.Core.csproj" />
  </ItemGroup>
  <!-- Portable publish profiles: add a README and zip the publish folder next to it. -->
  <ItemGroup>
    <None Include="Portable.txt" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="PortableZip" AfterTargets="Publish" Condition="'$(PortableZip)'=='true'">
    <PropertyGroup>
      <_PortableZipFile>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetFullPath('$(PublishDir)')))).zip</_PortableZipFile>
    </PropertyGroup>
    <Copy SourceFiles="Portable.txt" DestinationFiles="$(PublishDir)README.txt" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_PortableZipFile)" Overwrite="true" />
    <Message Importance="high" Text="Portable zip: $(_PortableZipFile)" />
  </Target>
</Project>
