<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MacKeymap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mac Keymap">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE765;" FontSize="16" />
        <TextBlock Text="Mac Keymap" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="第一階段原型 · 全域攔截未實作／未啟用"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="Nav" Grid.Row="1"
                    PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="True" OpenPaneLength="260"
                    SelectionChanged="Nav_SelectionChanged">
      <NavigationView.AutoSuggestBox>
        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜尋動作或按鍵" QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted" />
      </NavigationView.AutoSuggestBox>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="總覽" Tag="overview" Icon="Home" />
        <NavigationViewItem Content="操作偏好" Tag="prefs">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="進階自訂" Tag="advanced">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="輸入法" Tag="input">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="應用程式" Tag="apps">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="配置" Tag="profiles">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="一般" Tag="general">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="56,24,56,12" MaxWidth="1100">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="Breadcrumb_ItemClicked" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="DirtyText" Text="有尚未儲存的變更" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                <TextBlock Text="儲存" />
              </StackPanel>
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="S" />
              </Button.KeyboardAccelerators>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="PageScroll">
          <StackPanel x:Name="PageHost" Padding="56,0,56,40" Spacing="4" MaxWidth="1100" />
        </ScrollViewer>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
